rror):\n    \"\"\"Raised when an input field is invalid.\"\"\"\n    exit_code = 20\n    message = \"Data Validation Error\"\n\nclass UnexpectedSystemError(ExecutionError):\n    \"\"\"Raised for unexpected system errors.\"\"\"\n    exit_code = 1\n    message = \"System Error\"\n","numLines":55,"startLine":1,"totalLines":55}},"tool_use_id":"toolu_01DJNP2kURiipxJqGxw3UpJ5","duration_ms":0}

