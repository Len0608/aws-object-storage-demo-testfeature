\n\n# Check variablePrefix\nprint(f\"variablePrefix: {data.get('variablePrefix')}\")\n\n# Check required top-level keys\nfor key in [\"minReleaseLevel\", \"exportReleaseLevel\", \"sendEnvironment\", \"sendVariables\", \"agentFieldsRestriction\", \"credentialFieldsRestriction\"]:\n    print(f\"  {key}: {data.get(key)}\")\n\n# Check commands\nprint(f\"commands: {data.get('commands')}\")\n\nEOF","description":"Run structural checks on template.json"},"tool_use_id":"toolu_01RBg7HnFS9dydiWaYqr5RYN"}

