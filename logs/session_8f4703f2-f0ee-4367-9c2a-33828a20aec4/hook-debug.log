    "command": "python3 - <<'EOF'\nimport json\n\nwith open(\"/tmp/aws-object-storage-demo-testfeature/extension-code/src/templates/template.json\") as f:\n    raw = f.read()\n\n# Check for duplicate keys using a custom object_pairs_hook\nfrom collections import Counter\n\ndef detect_duplicates(pairs):\n    keys = [k for k, v in pairs]\n    counts = Counter(keys)\n    dups = [k for k, c in counts.items() if c > 1]\n    if dups:\n        raise ValueError(f\"Duplicate keys found: {dups}\")\n    return dict(pairs)\n\njson.loads(raw, object_pairs_hook=detect_duplicates)\nprint(\"No duplicate keys detected\")\n\ndata = json.loads(raw)\nfields = data.get(\"fields\", [])\nprint(f\"Number of fields: {len(fields)}\")\n\n# Check sequences\nsequences = [f.get(\"sequence\") for f in fields]\nprint(f\"Sequences: {sequences}\")\n\n# Check exactly one extensionStatus: true\next_status_true = [f[\"name\"] for f in fields if f.get(\"extensionStatus\") is True]\nprint(f\"extensionStatus=true fields: {ext_status_true}\")\n\n# Check fieldMappings are unique\nmappings = [f.get(\"fieldMapping\") for f in fields]\nmapping_counts = Counter(mappings)\ndup_mappings = [k for k, c in mapping_counts.items() if c > 1]\nprint(f\"Duplicate fieldMappings: {dup_mappings if dup_mappings else 'None'}\")\n\n# Check names are unique\nnames = [f.get(\"name\") for f in fields]\nname_counts = Counter(names)\ndup_names = [k for k, c in name_counts.items() if c > 1]\nprint(f\"Duplicate field names: {dup_names if dup_names else 'None'}\")\n\n# Check variablePrefix\nprint(f\"variablePrefix: {data.get('variablePrefix')}\")\n\n# Check required top-level keys\nfor key in [\"minReleaseLevel\", \"exportReleaseLevel\", \"sendEnvironment\", \"sendVariables\", \"agentFieldsRestriction\", \"credentialFieldsRestriction\"]:\n    print(f\"  {key}: {data.get(key)}\")\n\n# Check commands\nprint(f\"commands: {data.get('commands')}\")\n\nEOF",
    "description": "Run structural checks on template.json"
  },
